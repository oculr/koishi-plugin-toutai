{
  "name": "koishi-plugin-toutai-altered",
  "description": "带搞耍锐评的 Koishi 投胎模拟器插件。",
  "version": "0.0.1",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:koishi --external:koishi-plugin-markdown-to-image-service --external:koishi-plugin-puppeteer --outfile=lib/index.js && tsc --emitDeclarationOnly && node scripts/copy-assets.mjs",
    "prepack": "npm run build",
    "yakumo:after:esbuild": "node scripts/copy-assets.mjs"
  },
  "koishi": {
    "service": {
      "required": [
        "puppeteer",
        "database"
      ],
      "optional": [
        "markdownToImage"
      ]
    }
  },
  "license": "MIT OR Apache-2.0",
  "author": "oculr",
  "homepage": "https://github.com/oculr/koishi-plugin-toutai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oculr/koishi-plugin-toutai.git"
  },
  "bugs": {
    "url": "https://github.com/oculr/koishi-plugin-toutai/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "toutai",
    "reborn",
    "投胎模拟器",
    "重生模拟器",
    "中国投胎",
    "世界投胎"
  ],
  "peerDependencies": {
    "koishi": "^4.18.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "esbuild": "^0.28.2",
    "koishi-plugin-markdown-to-image-service": "^1.2.1",
    "koishi-plugin-puppeteer": "^3.9.0",
    "typescript": "^5.9.3"
  }
}
